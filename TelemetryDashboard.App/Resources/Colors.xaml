<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Backgrounds -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#050805"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#081008"/>
    <SolidColorBrush x:Key="PanelHoverBrush" Color="#0D180D"/>

    <!-- Terminal greens -->
    <SolidColorBrush x:Key="PrimaryGreenBrush" Color="#39FF88"/>
    <SolidColorBrush x:Key="SecondaryGreenBrush" Color="#21B85C"/>
    <SolidColorBrush x:Key="DimGreenBrush" Color="#557A61"/>
    <SolidColorBrush x:Key="BorderGreenBrush" Color="#225A35"/>

    <!-- Status -->
    <SolidColorBrush x:Key="WarningBrush" Color="#FFD95A"/>
    <SolidColorBrush x:Key="CriticalBrush" Color="#FF5A5A"/>

    <!-- Text -->
    <SolidColorBrush x:Key="MutedTextBrush" Color="#7FA98B"/>

</ResourceDictionary>